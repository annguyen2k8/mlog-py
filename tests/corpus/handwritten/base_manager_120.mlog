sensor power_cap battery1 @powerCapacity
sensor power_stored battery1 @powerNetStored
op div power_ratio power_stored power_cap
jump 6 greaterThan power_ratio 0.5
control enabled generator1 1 0 0 0
jump 7 always 0 0
control enabled generator1 0 0 0 0
set turret_idx 0
jump 22 greaterThanEq turret_idx 4
getlink t_block turret_idx
sensor t_hp t_block @health
sensor t_max_hp t_block @maxHealth
op div t_hp_ratio t_hp t_max_hp
jump 18 lessThan t_hp_ratio 0.4
control shoot t_block 0 0 1 0
jump 19 always 0 0
control shoot t_block 0 0 0 0
control enabled t_block 1 0 0 0
op add turret_idx turret_idx 1
jump 8 always 0 0
ubind @flare
sensor u_flag @unit @flag
jump 26 equal u_flag 1
ucontrol flag 1 0 0 0 0
ucontrol move 50 50 0 0 0
ucontrol boost 1 0 0 0 0
set cell_idx 0
jump 36 greaterThanEq cell_idx 8
read cell_val cell1 cell_idx
op add cell_val cell_val 1
write cell_val cell1 cell_idx
op add cell_idx cell_idx 1
jump 27 always 0 0
draw clear 0 0 0 0 0 0
draw color 0 255 0 255 0 0
op mul bar_w power_ratio 80
draw rect 0 0 bar_w 10 0 0
draw color 255 255 255 255 0 0
draw line 0 12 80 12 0 0
drawflush display1
op add reg_40 power_ratio 40
op add reg_41 power_ratio 41
